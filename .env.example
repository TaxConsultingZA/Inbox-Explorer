# ==============================================================================
# Microsoft Entra App-Only & Graph API Configuration
# ==============================================================================
# Azure AD / Microsoft Entra Tenant ID (Directory ID, GUID)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Entra Application (client) ID (GUID)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Entra Application Client Secret (Confidential Client credential)
# NEVER commit the real secret or expose to frontend client bundles
AZURE_CLIENT_SECRET=your_entra_app_client_secret_value_here

# Target Exchange Online Mailbox User Principal Name (UPN) or Primary SMTP
# The application is strictly locked to this server-configured target mailbox.
OUTLOOK_MAILBOX_UPN=shared-inbox@yourdomain.onmicrosoft.com

# ==============================================================================
# Web Application Authentication & Access Control
# ==============================================================================
# Comma-separated list of allowed Entra User Object IDs (OID GUIDs)
# Only authenticated users in this allowlist are permitted to view the mailbox.
AUTH_ALLOWED_USER_OBJECT_IDS=user-oid-guid-1,user-oid-guid-2

# Secret used to encrypt/sign session tokens and cookies (min 32 random characters)
AUTH_SECRET=generate_a_random_32_character_secret_key_here

# Application redirect URI registered in Microsoft Entra for user sign-in
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ==============================================================================
# Development & Performance Settings
# ==============================================================================
# Set to 'true' ONLY in local development to test UI with mock Exchange data
# when live Entra credentials are not yet provisioned.
# SAFETY ENFORCEMENT: Automatically ignored/rejected if NODE_ENV === 'production'
DEV_MODE=false

# Graph client timeout in milliseconds (default: 15000)
GRAPH_REQUEST_TIMEOUT_MS=15000

# Default page size for inbox listings (default: 15, maximum safe cap: 25)
# Safeguard: prevents large bulk pulls that trigger IT gateway / SOC anomaly alerts
GRAPH_PAGE_SIZE=15

# IT Gateway & SOC Safeguard limits
# Hard ceiling on message batch size per request (never exceeded even if requested)
GRAPH_SAFEGUARD_MAX_BATCH=25

# Anti-burst pacing: minimum interval between consecutive Graph requests in ms
GRAPH_MIN_REQUEST_INTERVAL_MS=300

